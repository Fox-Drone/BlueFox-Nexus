# 🌐 API
HOST=0.0.0.0
PORT=3000

# 🗄️ DATABASE
DATABASE_URL=postgres://user:password@localhost:5432/dbname
MAX_DB_CONNECTIONS=10
DB_TIMEOUT_SECS=5

# 📡 INGESTION
SYSLOG_PORT=5140
SNMP_PORT=161
SNMP_TRAP_PORT=162

# 🧠 RULE ENGINE
RULE_WORKER_THREADS=4

# 📊 LOGGING
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/bluefox/backend.log